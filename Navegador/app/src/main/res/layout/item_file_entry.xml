<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="14dp" android:paddingEnd="14dp"
    android:paddingTop="10dp" android:paddingBottom="10dp">
    <ImageView
        android:id="@+id/entry_icon"
        android:layout_width="36dp" android:layout_height="36dp"
        android:layout_marginEnd="12dp" />
    <LinearLayout
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView
            android:id="@+id/entry_name"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="15sp" android:singleLine="true" android:ellipsize="middle" />
        <TextView
            android:id="@+id/entry_subtitle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="#888888" />
    </LinearLayout>
</LinearLayout>
