<?xml version="1.0" encoding="utf-8"?>
<!--
    Barra retangular inferior estilo Android 16/17: cantos bem arredondados
    e gradiente horizontal suave. Feito só com <shape>/<gradient>, sem
    depender de Material 3/androidx - funciona em qualquer minSdk 21+.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="28dp" />
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="#332C2C2C"
        android:centerColor="#33454545"
        android:endColor="#332C2C2C" />
</shape>
