<?xml version="1.0" encoding="utf-8"?>
<!-- Botão circular "+" do card de atalhos - mesmo espírito visual do
     resto do app (shape puro, sem Material), com um leve destaque de
     borda pra se diferenciar do fundo translúcido do gradiente. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#26808080" />
    <stroke android:width="1dp" android:color="#40808080" />
</shape>
