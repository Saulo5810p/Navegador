<?xml version="1.0" encoding="utf-8"?>
<!--
    Nova estrutura da tela principal, estilo Chromium:

    - rootContainer: FrameLayout raiz. A WebView e injetada aqui por
      codigo (nunca no XML - ver comentario em MainActivity.initWebView()),
      ocupando a tela inteira quando ha navegacao em andamento.
    - homeLayout: camada de "nova aba" (logo + busca grande), visivel por
      cima da WebView quando nao ha navegacao ativa. Some assim que uma
      URL/busca e confirmada; volta quando o historico de navegacao acaba.
    - navToolbar: barra fina de navegacao (voltar + barra de URL truncada),
      so visivel durante a navegacao (escondida na Home).
    - bottomBar: barra retangular com gradiente, sempre visivel, abre a
      SettingsActivity ao ser tocada.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFFFF">

    <!-- WebView e injetada aqui via addView() em codigo -->
    <FrameLayout
        android:id="@+id/webViewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Barra fina de navegacao (voltar + URL atual), so visivel quando
         a WebView esta em uso (fora da Home) -->
    <LinearLayout
        android:id="@+id/navToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:background="@color/toolbar_bg"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&lt;" />

        <Button
            android:id="@+id/btnHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="&#8962;" />

        <TextView
            android:id="@+id/currentUrl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:singleLine="true"
            android:ellipsize="middle"
            android:textSize="13sp" />

        <!-- Alternador Desktop/Mobile, padrão em qualquer navegador
             Android - texto muda conforme o modo atual (ver
             MainActivity.updateDesktopModeButtonLabel()). -->
        <Button
            android:id="@+id/btnDesktopMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textSize="11sp"
            android:text="@string/desktop_mode_button_desktop" />
    </LinearLayout>

    <!-- Camada Home: logo + busca grande, estilo nova-aba do Chrome -->
    <LinearLayout
        android:id="@+id/homeLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#FFFFFFFF"
        android:padding="32dp">

        <TextView
            android:id="@+id/homeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textColor="#424242"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_search_field"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                android:contentDescription="@string/search_icon_description" />

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@null"
                android:hint="@string/search_hint"
                android:inputType="text"
                android:imeOptions="actionGo"
                android:singleLine="true"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/kernelInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#9E9E9E"
            android:textSize="11sp"
            android:text="@string/kernel_loading" />
    </LinearLayout>

    <!-- Barra retangular inferior com gradiente, sempre visivel - abre
         SettingsActivity ao ser tocada -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_bottom_bar_gradient"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/bottomBarLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/bottom_bar_settings"
            android:textColor="#212121"
            android:textSize="13sp" />
    </LinearLayout>

</FrameLayout>
