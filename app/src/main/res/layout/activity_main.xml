<?xml version="1.0" encoding="utf-8"?>
<!--
    Estrutura da tela principal, estilo Chromium (reformulada):

    - rootContainer: LinearLayout vertical raiz.
    - navToolbar (view_top_toolbar.xml): barra fina no topo, agora só com
      voltar + URL editável + reload. Desktop/Mobile, Downloads,
      Configurações e Histórico saíram daqui e foram pro painel lateral -
      dá mais espaço pra essa barra respirar.
    - contentArea: FrameLayout que contém, empilhados: webViewContainer,
      homeLayout, sidebarRoot (painel lateral, por cima de tudo quando
      aberto) e btnOpenSidebar (handle fixo "hamburguer" que abre o painel).
    - bottomBar antiga foi removida - Configurações agora é um atalho
      dentro da sidebar (ver view_sidebar.xml).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <include
        android:id="@+id/navToolbarInclude"
        layout="@layout/view_top_toolbar" />

    <!-- Area de conteudo: fica com todo o espaco que sobra abaixo da
         navToolbar. WebView, Home e o painel lateral se empilham aqui. -->
    <FrameLayout
        android:id="@+id/contentArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- WebView e injetada aqui via addView() em codigo -->
        <FrameLayout
            android:id="@+id/webViewContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Camada Home: logo + busca grande, estilo nova-aba do Chrome -->
        <LinearLayout
            android:id="@+id/homeLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/colorBackground"
            android:padding="32dp">

            <TextView
                android:id="@+id/homeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="22sp"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginBottom="24dp" />

            <!-- Barra de busca grande: fundo com gradiente + sombra via
                 Custom View/Canvas (GradientShadowCardView), empilhada
                 atrás do ícone+campo num FrameLayout. Agora mais larga
                 (90% da tela, limitada a 640dp em telas grandes) e
                 centralizada - antes ocupava a mesma largura do card de
                 atalhos compacto, o que deixava os dois desproporcionais. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal">

                <com.xaulinxs.aosp.browser.widget.GradientShadowCardView
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    app:cornerRadiusDp="32" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_search"
                        android:contentDescription="@string/search_icon_description" />

                    <EditText
                        android:id="@+id/searchInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:background="@null"
                        android:hint="@string/search_hint"
                        android:inputType="text"
                        android:imeOptions="actionGo"
                        android:singleLine="true"
                        android:textSize="18sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Card de atalhos (estilo Chromium): agora um retângulo
                 compacto (wrap_content, não match_parent), centralizado
                 abaixo da barra de busca larga - antes esticava até a
                 borda e ficava desproporcional ao lado da busca. Ver
                 view_shortcuts_card.xml e
                 MainActivity.renderShortcuts()/showAddShortcutDialog(). -->
            <include
                android:id="@+id/shortcutsCardInclude"
                layout="@layout/view_shortcuts_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal" />

            <TextView
                android:id="@+id/kernelInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="#9E9E9E"
                android:textSize="11sp"
                android:text="@string/kernel_loading" />
        </LinearLayout>

        <!-- Painel lateral de atalhos de função - overlay por cima de
             Home/WebView, escondido por padrão (visibility="gone" dentro
             de view_sidebar.xml). Fica depois na ordem de empilhamento
             pra desenhar por cima quando visível. -->
        <include
            android:id="@+id/sidebarInclude"
            layout="@layout/view_sidebar" />

        <!-- Handle fixo que abre o painel lateral - canto superior
             esquerdo do contentArea, sempre visível (mesmo local onde o
             painel nasce). Some quando o painel já está aberto (o botão
             de fechar fica dentro do próprio painel). -->
        <FrameLayout
            android:id="@+id/btnOpenSidebar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start|top"
            android:layout_margin="10dp"
            android:background="@drawable/bg_shortcut_add_button"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_menu_hamburger"
                android:contentDescription="@string/sidebar_open_content_description" />
        </FrameLayout>
    </FrameLayout>

</LinearLayout>
