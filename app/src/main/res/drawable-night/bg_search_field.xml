<?xml version="1.0" encoding="utf-8"?>
<!-- Variante escura do campo de busca - resolvida automaticamente pelo
     sistema de recursos -night do Android quando o tema DayNight está em
     modo escuro (ver ThemeManager e themes.xml), sem precisar de nenhum
     código extra pra trocar a cor manualmente. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FF2C2C2E" />
    <corners android:radius="28dp" />
    <stroke android:width="1dp" android:color="#33FFFFFF" />
</shape>
