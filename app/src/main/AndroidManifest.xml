<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Upload/download/file manager (com.xaulinxs.funcoes) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Necessária pro file manager próprio navegar livremente pela memória
         interna inteira (não só a pasta privada do app) a partir do Android 11.
         É uma permissão especial: o usuário precisa conceder manualmente numa
         tela do sistema (tratado em FileManagerActivity.resolveRootAndOpen). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Foreground Service de download com notificação de progresso real -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Tipo específico exigido a partir do Android 14 (API 34) para
         serviços de sincronização/transferência de dados em segundo
         plano - sem isso, startForeground() com esse tipo lança
         SecurityException no Android 14+. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Obrigatória a partir do Android 13 (API 33) para qualquer
         notificação exibida pelo app, incluindo a de progresso do
         download - sem ela, a notificação simplesmente não aparece
         (o Foreground Service continua rodando normalmente). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Busca por voz (barra de busca da Home e widget), via
         android.speech.SpeechRecognizer nativo com popup próprio do app -
         precisa de permissão de runtime a partir do Android 6 (API 23)
         pra capturar áudio do microfone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Obrigatório a partir do Android 11 (API 30): sem declarar esse
         <queries>, PackageManager não enxerga o serviço de reconhecimento
         de voz do sistema (visibilidade de pacotes) e
         SpeechRecognizer.isRecognitionAvailable() sempre volta false. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".BrowserApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.AospBrowser"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Intent-filter que faz o app aparecer na lista de
                "Navegador padrão" do Android (Configurações > Apps >
                Apps padrão > Navegador) e no seletor "Abrir com" quando
                outro app manda abrir um link http(s). BROWSABLE é
                obrigatório: sem ela, o sistema não considera o app um
                navegador válido para esse papel. android:autoVerify
                habilita App Links (verificação de domínio via
                assetlinks.json) quando aplicável - sem um domínio
                próprio verificado, o Android ainda mostra o app no
                seletor manual de navegador padrão normalmente.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>

            <!--
                Intent-filters que fazem o app aparecer no seletor "Abrir
                com" quando o usuário toca num arquivo local (ex: no
                gerenciador de arquivos do sistema, ou um anexo salvo).
                Sem categoria BROWSABLE aqui de propósito: BROWSABLE é só
                pro papel de "navegador padrão" de links http(s); pra
                arquivo local isso não se aplica e incluir a categoria
                indevidamente faz alguns launchers/apps de arquivos
                filtrarem o app da lista de destino.

                mimeType="*/*" cobre tanto file:// quanto content://
                (formas como cada app de arquivos/anexo despacha a VIEW)
                e aceita qualquer tipo de arquivo, não só html/texto -
                decisão explícita do usuário de manter o filtro
                abrangente em vez de restringir por extensão.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!--
                Alguns apps de arquivos mandam VIEW com file:// e SEM
                mimeType nenhum (contam só com a extensão do nome do
                arquivo pra decidir quem abre). Sem pathPattern aqui de
                propósito: o app fica disponível como "Abrir com" pra
                QUALQUER arquivo local, não só .html/.htm/.txt - decisão
                explícita do usuário, mesmo sabendo que isso inclui tipos
                que um navegador tradicionalmente não abriria (.pdf,
                .zip, etc.). A WebView decide o que fazer com o conteúdo
                em tempo de execução; o filtro aqui só controla em quais
                telas "Abrir com" o app aparece como opção.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:scheme="content" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:label="@string/settings_title"
            android:exported="false" />

        <activity
            android:name=".DownloadsActivity"
            android:label="@string/settings_downloads"
            android:exported="false" />

        <activity
            android:name=".HistoryActivity"
            android:label="@string/history_title"
            android:exported="false" />

        <activity
            android:name="com.xaulinxs.funcoes.FileManagerActivity"
            android:label="File Manager"
            android:exported="false" />

        <!-- Widget de busca 4x1 (estilo Chromium) na tela inicial do
             Android - toque abre a MainActivity direto na busca. -->
        <receiver
            android:name=".widget.BrowserSearchWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_browser_search_info" />
        </receiver>

        <!-- Foreground Service que monitora o progresso de um download e
             mantém a notificação persistente atualizada em tempo real. -->
        <service
            android:name="com.xaulinxs.funcoes.download.DownloadForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            Services de processo sandbox usados pela lib WebViewUpgrade
            (com.norman.webviewup) para o modo multiprocesso do Chromium.
            Antes vinham automaticamente via merge do AAR do Maven Central;
            como agora o código-fonte da lib foi vendorizado direto no
            projeto, precisam ser declarados aqui manualmente.
        -->
        <service
            android:name="com.norman.webviewup.lib.sandbox.stub.StubSandboxedProcessService0"
            android:exported="false"
            android:process=":sandboxed_process0" />
        <service
            android:name="com.norman.webviewup.lib.sandbox.stub.StubSandboxedProcessService1"
            android:exported="false"
            android:process=":sandboxed_process1" />
        <service
            android:name="com.norman.webviewup.lib.sandbox.stub.StubSandboxedProcessService2"
            android:exported="false"
            android:process=":sandboxed_process2" />
        <service
            android:name="com.norman.webviewup.lib.sandbox.stub.StubSandboxedProcessService3"
            android:exported="false"
            android:process=":sandboxed_process3" />
        <service
            android:name="com.norman.webviewup.lib.sandbox.stub.StubSandboxedProcessService4"
            android:exported="false"
            android:process=":sandboxed_process4" />
    </application>
</manifest>
